# <check|pull>  <path on the server>  <path relative to infra/>   (see snapshot.sh)
# check = this repo is the source of truth, applied to the server by hand / via the Forge UI.
# pull  = Forge or the OS generates it; the local copy is a reference snapshot.

check /etc/nginx/sites-available/jerome-arfouche.ca  nginx.conf
pull  /etc/nginx/forge-conf/jerome-arfouche.ca/before/redirect.conf             forge-conf/before/redirect.conf
pull  /etc/nginx/forge-conf/jerome-arfouche.ca/before/ssl_redirect.conf         forge-conf/before/ssl_redirect.conf
pull  /etc/nginx/forge-conf/jerome-arfouche.ca/server/letsencrypt_challenge.conf forge-conf/server/letsencrypt_challenge.conf
